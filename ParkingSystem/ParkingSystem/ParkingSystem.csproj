<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <AssemblyTitle>ParkirAja</AssemblyTitle>
    <Product>ParkirAja</Product>
    <Company>ParkirAja</Company>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\Login.cs;Views\MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\JukirDashboard.cs;Views\AdminDashboard.cs;Views\VehicleEntry.cs;Views\VehicleExit.cs;Views\TransactionHistory.cs;Views\DailyReport.cs;Views\ReportValidation.cs;Views\ParkingAreas.cs;Views\JukirAccounts.cs;Views\ExportReports.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ParkingSystem.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="dotenv.net" />
  </ItemGroup>

</Project>
