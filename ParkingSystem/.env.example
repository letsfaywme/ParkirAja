# Salin berkas ini menjadi .env lalu sesuaikan nilainya.
# Berkas .env TIDAK boleh di-commit (sudah masuk .gitignore).

# Cara 1 — satu connection string utuh (paling sederhana).
# Bila diisi, seluruh variabel DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD diabaikan.
# DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=parkiraja;Username=postgres;Password=postgres

# Cara 2 — komponen terpisah.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parkiraja
DB_USER=postgres
DB_PASSWORD=postgres
